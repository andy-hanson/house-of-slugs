-image-config record
	tile-size nat-size
	size nat-size
-area-tiles nat16(a image-config)
	to area a.size
-size-pixels nat-size(a image-config)
	a.size * a.tile-size

image-path string(a image-id)
	"images/{a}.png"
image-size nat-size(a image-id)
	size-pixels image-config a

-image-config image-config(image image-id)
	match image
	as basement
		tile-size: 32.square, size: (3, 1)
	as bathroom
		tile-size: 32.square, size: (3, 1)
	as bedroom
		tile-size: 32.square, size: (3, 1)
	as beams
		tile-size: 32.square, size: (4, 4)
	as big-slug
		tile-size: 32.square, size: (4, 8)
	as big-ice-slug
		tile-size: 32.square, size: (4, 8)
	as blocks
		tile-size: 32.square, size: (4, 3)
	as block-overlay
		tile-size: 32.square, size: (4, 2)
	as burn-up
		tile-size: 20.square, size: (17, 1)
	as compass
		tile-size: 32.square, size: (2, 4)
	as foyer
		tile-size: 32.square, size: (3, 1)
	as garden
		tile-size: 32.square, size: (3, 1)
	as harley
		tile-size: 32.square, size: (4, 3)
	as harley-dialog
		tile-size: 128.square, size: (2, 1)
	as hazards
		tile-size: 32.square, size: (4, 5)
	as items
