subscript image-and-region(image image-id, index nat16)
	config = image-config image
	assert index < config.area-tiles
	image: image.to
	source:
		x = index % config.size.width
		y = index / config.size.width
		left: x * config.tile-size.height
		top: y * config.tile-size.width
		width: config.tile-size.width
		height: config.tile-size.height
subscript image-and-region[](image image-id, indices nat16 range)
	map indices, image[it]

shower image-and-region()
	shower.to, left: 0, top: 0, width: 1480, height: 960

directional-warp image-and-region(dir dir4)
	signs[dir.to]
stairs image-and-region()
	signs[4]
puzzle-win-switch image-and-region()
	signs[5]

slimy image-and-region() = hazards[0]
valve image-and-region() = hazards[1]
breakable-wall image-and-region() = hazards[2]
pillow image-and-region() = hazards[3]
active-fire image-and-region() = hazards[4]
potential-fire image-and-region() = hazards[5]
active-flood image-and-region() = hazards[6]
potential-flood image-and-region() = hazards[7]
frozen-in-ice image-and-region() = hazards[9]
throwable image-and-region() = hazards[12]
selected image-and-region() = hazards[13]
lit-bomb-image image-and-region(kind bomb-kind)
	hazards[16 + kind.to]
breadcrumb image-and-region() = hazards[19]

beam-line animation(kind beam-kind)
	match kind
	as ice
		beams[0 .. 4], 1.seconds
	as soda
		beams[8 .. 12], 1.seconds
beam-end animation(kind beam-kind)
	match kind
	as ice
		beams[4 .. 8], 1.seconds
	as soda
		beams[12 .. 16], 1.seconds

tile-at-pos image-and-region(a game, pos grid-pos)
	# Use 1 as the default tile since this is the wall tile
	index = if a.tile-map.bounds[pos] then a.tile-map.tiles[pos] else 1
	a.area.tiles-image[index]
-tiles-image image-id(a area)
	match a
	as backyard then garden
	as basement then basement
	as bathroom then bathroom
	as bedroom then bedroom
	as foyer then foyer
	as garden then garden
	as kitchen then kitchen

item-image image-and-region(a basic-item)
	index nat16 = match a
	as cookie
		0
	as soda
		1
	as lemon
		2
	as soap
		3
	as smoke-bomb
		4
	as sleep-bomb
		5
	as pepper-bomb
		6
	as perfume
		7
	as hare-plush
		8
	as sparkler
		9
	as napkin
		10
	as ice-soda
		11
	items[index]
missing-item-image image-and-region()
	items[26]
crown image-and-region()
	items[27]

equipment-image image-and-region(a equipment)
	index nat16 = match a
	as bag0
		20
	as bag1
		20
	as breadcrumbs
		21
	as compass
		22
	as glove
		23
	as monocle
		24
	items[index]

compass-target enum(door, harley, slug-any, slug-new, stairs, treasure)
compass-icon image-and-region(a compass-target)
	compass[a.to]
compass-background image-and-region()
	compass[6]
compass-cover image-and-region()
	compass[7]

flashlight-part-image image-and-region(a flashlight-part)
	index nat16 = match a
	as flashlight-shell
		16
	as flashlight-bulb
		17
	as flashlight-battery
		18
	items[index]

harley-animation animation(dir dir4, is-walking bool)
	if is-walking
		frames: harley[dir.to], harley[dir.to + 4]
		duration: harley-move-duration
	else
		harley[dir.to],
harley-move-duration duration()
	seconds 1/3
harley-stuck-animation animation()
	frames: harley[8 .. 10]
	duration: seconds 1/2
harley-slug-on-face image-and-region()
	harley[10]

player-throw-animation animation(dir dir4)
	frames: player[8 + dir.to],
	duration: 0.5.seconds
player-animation animation(a player, is-walking bool)
	index nat8 = if is-slipped a
		16
	elif is-sleeping a
		17 + a.is-holding-pillow.to
	elif is-holding-pillow a
		12 + a.dir.to
	else
		a.dir.to
	if index < 4 and is-walking
		frames: player[index], player[index + 4]
		duration: player-move-duration
	else
		player[index],
player-move-duration duration()
	seconds 1/4

big-slug-head image-and-region(dir dir4, flags_ slug-flags, is-main-head bool, sees-hare bool, stops-chasing bool)
	which nat16 = if flags_[sleeping]
		16
	elif flags_[dizzy]
		20
	elif not is-main-head
		12
	elif sees-hare
		4
	elif stops-chasing
		8
	(if flags_[ice] then big-ice-slug else big-slug)[which + dir.to]
big-slug-straight-middle image-and-region(flags_ slug-flags, dir dir4)
	(if flags_[ice] then big-ice-slug else big-slug)[24 + dir.to]
big-slug-curved-middle image-and-region(flags_ slug-flags, kind curve-kind)
	which nat16 = match kind
	as north-to-east then 1
	as east-to-south then 2
	as south-to-west then 3
	as west-to-north then 0
	as north-to-west then 2
	as west-to-south then 1
	as south-to-east then 0
	as east-to-north then 3
	(if flags_[ice] then big-ice-slug else big-slug)[28 + which]

slug-move-duration duration()
	(1/3).seconds
slug-as-item image-and-region()
	(small-slug-animation north, sleeping, false, false, false).frames[0]
small-slug-animation animation(dir dir4, flags_ slug-flags, sees-hare bool, stops-chasing bool, is-moving bool)
	group nat8 = if flags_[bull]
		20
	elif flags_[spits-soda]
		40
	elif flags_[ice]
		60
	elif flags_[looks-like-cookie]
		80
	offset nat8 = if sees-hare
		8 + dir.to
	elif stops-chasing
		12 + dir.to
	elif is-moving
		# The slug may now logically be in the sleeping state, but use the walking sprite until it's fully in position
		dir.to
	elif flags_[sleeping]
		if flags_[holding-doll] then 17 else 16
	elif flags_[dizzy]
		18
	else
		dir.to
	image = small-slug[group + offset]
	if offset < 4 and is-moving
		frames: image, small-slug[group + offset + 4]
		duration: slug-move-duration
	else
		image,

smoke-image image-and-region(kind smoke-kind)
	smoke[kind.to::nat16]

max-blocks nat16()
