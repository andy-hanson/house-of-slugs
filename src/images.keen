		small-cookie-slug-dialog[1]
	as cookie-slug-waking-up
		small-cookie-slug-dialog[2]
	as cookie-slug-frozen
		small-cookie-slug-dialog[3]
	as cookie-slug-wow
		small-cookie-slug-dialog[4]
	as harley
