animation record -new
	frames image-and-region[]
	duration duration
	duration-per-frame duration
-new animation(frames image-and-region[], duration duration)
	frames.size isnt 0
	frames, duration, duration / frames.size.to
new animation(frame image-and-region)
	(frame,), forever, forever

burn-up-animation animation()
	whole-image-animation burn-up, 0.6.seconds

splash-animation animation()
	whole-image-animation splash, 0.6.seconds

sparkler-animation animation()
	whole-image-animation sparkler, 0.3.seconds

the-end image-and-region(difficulty difficulty)
	match difficulty
	as easy
		the-end-easy[0]
	as normal
		the-end-normal[0]
	as hard
		the-end-hard[0]

-whole-image-animation animation(image image-id, duration duration)
	frames: for i in image.image-config.area-tiles then image[i]
	duration: duration
