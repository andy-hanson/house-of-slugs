import
	grid/geometry
	grid/grid-set
	grid/grid-set-set
	keen/col/enum-map
	keen/parse
	./area-setup-types
	./game-types

area-config area-config(area area) = area-configs[area]
area-configs (area, area-config) enum-map()
	make of area
		match area
		as backyard then backyard
		as basement then basement
		as bathroom then bathroom
		as bedroom then bedroom
		as foyer then foyer
		as garden then garden
		as kitchen then kitchen

-backyard area-config()
	layout:
		origin-warp: basement
		length: 48
		sites:
			-
				placement: farthest
				kind: puzzle
					layout: quote
						-2, 1 to 3, 8
						 RRR
						 CCC
						•••••
						•••••
						•••••
						•••••
						•••••
					rewards: alice.reward-slug, reward-harley, bob.reward-slug
	map:
		initial:
			ground: parse grid-set, quote
				-2, 0 to 3, 4
				  •
				•••••
				•••••
				  •
			safe: parse grid-set, quote
				-2, 1 to 3, 4
				  •
				 •••
				•••••
			exit: 0, 4
			entities:
				- slug slug-of-beginnings, npc, (-2, 2), east
				- slug slug-of-adversity, npc, (2, 2), west
			puzzle: ()
		maze-safe-tiles: adjust-safe-tiles 5
		maze: extra-hard-maze-config
	sprinkle:
		items: ()
		slugs: garden-slugs
		pillows:
			- easy, 4
			- normal, 3
			- hard, 2
	player-gravity-radius: 24
	visibility: perfect

