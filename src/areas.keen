					exit: 3, 7
			-
				placement: midway-left
				kind: puzzle
					layout: quote
						-1, 1 to 9, 6
						 •••  ••CR
						 ••••V•• R
						 ••••••• R
						 •• •••• R
						V••  •••
					rewards:
						-- n-of 3, bathroom-random-item
						- reward-equipment false
					features: fire | flood
			-
				placement: midway-right
				kind: puzzle
					layout: quote
						-1, 1 to 7, 6
						   •••CR
						  •••• R
						 ••••  R
						 •••   R
						V••
					rewards:
						-- n-of 3, bathroom-random-item
						- reward-equipment true
					features: fire | flood
			-
				placement: farthest
				kind: puzzle
					layout: quote
						-1, 1 to 5, 8
						  RRRR
						     C
						 •••••
						 •••••
						 ••V••
						 •••••
						V•••••
					rewards:
						-- n-of 3, bathroom-random-item
						- reward-flashlight-part
					features: fire | flood
	map:
		initial:
			ground: parse grid-set, quote
				-1, 0 to 3, 5
				 •
				 •••
				 • •
				••••
				 •
			safe: (0, 1),
			exit: 0, 5
			entities:
				- slug scrubby, npc, (-1, 1), east
			puzzle:
				placement: tutorial
				layout:
					puzzle-tiles:
						rect grid-rect = bottom-left: (0, 1), top-right: (3, 4)
						rect.to::grid-set - (1, 2)::grid-pos
					entrance: 0, 0
					breakable-walls: (0, 4),
					valves: (1, 2),
				entities:
					fire: (2, 1),
					flood: (2, 3),
		maze-safe-tiles: adjust-safe-tiles 5
		maze: usual-maze-config
	sprinkle:
		items:
			-- n-of 3, soap
			- soda
			- bomb-smoke
			- perfume
		slugs:
			- chilly
			- dudley
			- frosty
			- oozy
			- oyl
			- slippy
			- slithy
			- sludgy
			- slushy
			- snowflake
			- snowy
			- soggy
		# Note: Having fewer of these actually tends to make the game harder,
		# since they are useful for splooshing pursuing slugs.
		fire-and-flood: 16
		extra-valves:
			- easy, 6
			- normal, 4
			- hard, 2
	player-gravity-radius: 18
	visibility: perfect

