-usual-maze-config (difficulty, maze-config) enum-map()
	# The maze fills in dead ends first, then connections.
	# So the connectivity of the maze is connections - dead-ends
	make of difficulty
		dead-ends:
			match difficulty
			as easy then 42 / 96
			as normal then 44 / 96
			as hard then 45 / 96
		connections: 46 / 96

| The backyard is in two segments: First you traverse it, then you trap Harley.
| Since it is small, we want the maze to be extra hard to compensate so the first phase is not too easy.
| Then in the second phase, having more dead ends makes it easier to trap Harley.
-extra-hard-maze-config (difficulty, maze-config) enum-map()
	make of difficulty
		dead-ends:
			match difficulty
			as easy then 88 / 192
			as normal then 90 / 192
			as hard then 91 / 192
		connections: 92 / 192

-basement-random-item reward-random-item()
	# Also omitting sparkler here, since those are plentiful as non-random items
	choices: basement-item-choices
-basement-item-choices basic-item[]()
	# Omit smoke-bomb (too weak), napkin (too powerful)
	# Omit sparkler since it isn't useful outside of the basement
	cookie, hazel-plush, ice-soda, lemon, perfume, bomb-pepper, soap, soda, bomb-sleep
-bathroom-random-item reward-random-item()
	# Omit soap since those are plentiful as non-random items
	choices: ice-soda, perfume, bomb-smoke, soap
-bedroom-random-item reward-random-item()
	choices: cookie, hazel-plush, bomb-sleep
-foyer-random-item reward-random-item()
	choices: cookie, bomb-smoke
-kitchen-random-item reward-random-item()
	choices: cookie, lemon, bomb-pepper, soda

-garden-slugs slug-id set()
	- slugette
	- sluggo
	- sluggus
	- sluggy
	- slugicus
	- slug-jr
	- slugsly
	- slugson
	- slug-sr
	- slug-x

-adjust-safe-tiles (difficulty, nat) enum-map(hard nat)
	make of x
		match x
		as easy then hard * 2
		as normal then hard * 3 / 2
		as hard then hard
