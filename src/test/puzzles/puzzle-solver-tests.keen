import
	grid/geometry
	grid/grid-set
	grid/grid-set-set
	keen/parse
	../../game/game-types
	../../puzzles/puzzle-solver

test
	bits-for-blocks 3, 1 is 0b11111000,
	bits-for-blocks 3, 2 is 0b11111000, 0xff
	bits-for-blocks 10, 3 is 0, 0b11111100, 0xff

-list-transitions block-puzzle-state[](options block-puzzle-options, state block-puzzle-state)
	puzzle = simple-puzzle map state.blocks, it.occupied-space
	list-transitions options, puzzle, state

test
	state block-puzzle-state =
		player: 0, 0
		blocks:
			-
				color: 0
				occupied-space: (0, 1), (0, 2)
				lit: unlit
				tunnel: ()
			-
				color: 1
				occupied-space: (1, 1),
				lit: unlit
				tunnel: ()
			-
				color: 2
				occupied-space: (1, 0), (2, 0)
				lit: unlit
				tunnel: ()
		pillows: ()
		is-holding-pillow: false
		shower: false
	options block-puzzle-options =
		space: full (3, 3)
		player-initial-position: 0, 0
		goal: light-every-block
		positions-near-valves: ()
		tunnels: false
	transitions = list-transitions options, state
	transitions is
		-
			state
			then set blocks * 0.nth * lit, lit
			then set blocks * 1.nth * lit, lit
		-
			state
			then set blocks * 2.nth * lit, lit
			then set blocks * 1.nth * lit, lit

