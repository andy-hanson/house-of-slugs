	step-bedroom
	step-indoors
	step-outdoors
	throw_
	valve

animated-sound record
	| Sound plays during the range
	duration duration range
	volume float32
	pitch-variation float32
	pan float32
	sounds sound-id set
do
	assert 0::float32 <= volume and volume <= 1
	assert 0::float32 <= pitch-variation and pitch-variation <= 1
	assert -1::float32 <= pan and pan <= 1
	assert any sounds
delay animated-sound(a animated-sound, delay duration)
	duration: a.duration.low + delay .. a.duration.high + delay
	volume: a.volume
	pitch-variation: a.pitch-variation
	pan: a.pan
	sounds: a.sounds
	# TODO: 'modify' on a record with an empty type in it causes internal errors in keen
	# modify a, duration, it.low + delay .. it.high + delay

sound-path string(a sound-id)
	"sounds/{to::symbol a}.wav"

sound-authors string set()
	all-authors map members::sound-id[], it.credit
