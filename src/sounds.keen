import
	./credit
	keen/io/duration
	keen/random/random
	keen/random/util

sparkler-sounds animated-sound(volume float32)
	duration: () .. forever
	volume: 0.5 * volume
	pitch-variation: 0
	pan: 0
	sounds: sparkler0, sparkler1, sparkler2

vary-volume float32(variation float32) random
	assert 0::float32 <= variation and variation <= 1
	if variation == 0
		0.5
	else
		max-diff = variation / 2
		random (0.5 - max-diff)::float32 .. (0.5 + max-diff)

| Variation is in [0, 1].
| With no variation, result is always 1.
| With maximum variation, result is a random number in [-1/2, 2].
vary-pitch float32(variation float32) random
	assert 0::float32 <= variation and variation <= 1
	if variation == 0
		1
	else
		2 ** random (-variation .. variation)

sound-id enum
	big-slug0
	big-slug1
	big-slug2
	block-light
	bomb
	burn-up
	door
	eat
	got-item
	got-major-item
	harley0
	harley1
	harley2
	harley3
	ice-beam
	jump
	lose
	menu
	not-allowed
	perfume
	player0
	player1
	player2
	player3
	puzzle-solved
	soda
	slip
	splash
	spotted
	slug0
	slug1
	slug2
	slug3
	slug4
	slug5
	slug6
