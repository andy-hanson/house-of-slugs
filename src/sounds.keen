import
	./credit
	keen/io/duration
	keen/random/random
	keen/random/util

sparkler-sounds animated-sound(volume float32)
	duration: () .. forever
	volume: 0.5 * volume
	pitch-variation: 0
	pan: 0
	sounds: sparkler0, sparkler1, sparkler2

vary-volume float32(variation float32) random
	assert 0::float32 <= variation and variation <= 1
	if variation == 0
		0.5
	else
		max-diff = variation / 2
		random (0.5 - max-diff)::float32 .. (0.5 + max-diff)

| Variation is in [0, 1].
| With no variation, result is always 1.
| With maximum variation, result is a random number in [-1/2, 2].
vary-pitch float32(variation float32) random
	assert 0::float32 <= variation and variation <= 1
	if variation == 0
		1
	else
		2 ** random (-variation .. variation)

sound-id enum
	big-slug0
	big-slug1
	big-slug2
	big-slug-wow
	block-light
	bomb
	burn-up
	door
	eat
	got-item
	got-major-item
	harley0
	harley1
	harley2
	harley3
	ice-beam
	jump
	lose
	menu
	not-allowed
	perfume
	player0
	player1
	player2
	player3
	puzzle-solved
	soda
	slip
	slug-wow
	splash
	slug0
	slug1
	slug2
	slug3
	slug4
	slug5
	slug6
	slug7
	slug8
	sparkler0
	sparkler1
	sparkler2
	stairs
	step-basement
	step-bedroom
	step-indoors
	step-outdoors
	throw_
	valve

sound-volume float32(a sound-id)
	match a
	as big-slug-wow or not-allowed or puzzle-solved or step-bedroom
		1
	as got-item or valve
		1/4
	else
		1/2

animated-sound record
	| Sound plays during the range
	duration duration range
	volume float32
	pitch-variation float32
	pan float32
	sounds sound-id set
do
	assert 0::float32 <= volume and volume <= 1
	assert 0::float32 <= pitch-variation and pitch-variation <= 1
	assert -1::float32 <= pan and pan <= 1
	assert any sounds
delay animated-sound(a animated-sound, delay duration)
	duration: a.duration.low + delay .. a.duration.high + delay
	volume: a.volume
	pitch-variation: a.pitch-variation
	pan: a.pan
	sounds: a.sounds
	# TODO: 'modify' on a record with an empty type in it causes internal errors in keen
	# modify a, duration, it.low + delay .. it.high + delay

sound-path string(a sound-id)
	"sounds/{to::symbol a}.wav"

sound-authors string set()
	all-authors map members::sound-id[], it.credit
credit credit(a sound-id)
	match a
	as big-slug0 or big-slug1 or big-slug2
		url: "freesound.org/s/816782"
		authors: "YannSauvin",
	as big-slug-wow
		url: "opengameart.org/content/farm-animals"
		authors: "Secretlondon",
	as block-light
		url: "opengameart.org/content/dings-0"
		authors: "Wandering Door Games",
	as bomb or perfume
