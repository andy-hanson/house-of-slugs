import
	grid/geometry
	grid/grid-entities
	grid/grid-set
	grid/sparse-grid
	grid/util/more-geometry
	keen/col/enum-set
	keen/parse
	keen/string/util
	./game-types
	./game-util

apply-input-command game(a game, input string) game-change-effects
	try
		apply-input-command-inner a, input
	catch e as deserialize-error
		log-error "Error parsing command: Expected {e.expected}, actual {e.value}"
		a
	catch as parse-error
		log-error "Error parsing command"
		a

-apply-input-command-inner game(a game, input string) game-change-effects
	stripped = strip input
	do if any stripped else
		log-error "Needs a command"
		a
	command string, args string = if x, y = try-split-once stripped, " "
		x.to, y.to
	else
		stripped, ""
	match command
	as add-item
		item item = args.to
		modify a, inventory, it ~ item
	# Does not immediately win the puzzle, but clears the blocks so it's easy
	as clear-puzzle
		do if puzzle = find a.puzzles, it.bounds[a.player.pos] else
			log-error "Not in a puzzle"
			a
		modify a, exclusive-entities, of x
			remove-overlapping-where x, puzzle.expanded-bounds, it.block
	as get
		log debug-get a, args.to
		a
	as move-player
		displacement grid-displacement = to parse kid, args
		modify a, player * pos, {it + displacement}
	as set
		do if name, value = try-split-once args, " " else
			log-error "Syntax: set <name> <value>"
			a
		try
			json = parse kid, value
			debug-set a, name.to, json
		catch e as parse-error
			log-error e
			a

	else
		log-error "Supported commands: add-item, get, load-area, move-player, set"
		a

-debug-get json(a game, name symbol)
	if lens = debuggable name
		get lens, a
	else
		match name
		as checkpoint
			a.checkpoint.to
		as difficulty
			a.difficulty.to
		as ground-items
			to map-optionally::ground-item[] a.exclusive-entities, it.ground-item
		as lowest-difficulty
			a.lowest-difficulty.to
		as ground
			a.ground.to
		as harley
			if x = find a.exclusive-entities, it.harley then x.to
		as key-items
			for? x in a.exclusive-entities
				if ground-equipment x
					x.to
				elif ground-flashlight-part x
					x.to
		as music-state
			a.music-state.to
		as player
			a.player.to
		as puzzles
			a.puzzles.to
		as safe-tiles
			to a.tile-map.safe
		as seed
			a.seed
		as slugs
			to a.slugs
		as slug-plushes
			to positions-where a.exclusive-entities, it.pillow
		as slugs-by-distance
			pairs (slug-id, float)[] = for slug in a.slugs
				- slug.id
				- distance! slug.occupied-space, a.player.pos
			to sort pairs, it.b
		as smoke
			a.smoke.to
		as valves
			to positions-where a.exclusive-entities, it.valve
		as walls
			a.walls.to
		as warps
			to for?::warp[] x in a.exclusive-entities then warp x
		else
			if id = name.to::slug-id?
				to find a.exclusive-entities, {it.slug and it.id == id}
			else
				"unknown name {name}"
-slugs slug[](a game)
	map-optionally a.exclusive-entities, it.slug
-debug-set game(a game, name symbol, value json)
	try
		if lens = debuggable name
			set lens, a, value
		else
			log-error "unknown name {name}"
			a
	catch e as deserialize-error
		log-error e
		a

-debuggable (game, json) lens?(name symbol)
	match name
	as equipment
		to-from-json equipment
	as flashlight-parts
		to-from-json flashlight-parts
	as inventory
		to-from-json inventory
	as "player.is-holding-pillow"
		to-from-json player * is-holding-pillow
	as "player.pos"
		to-from-json player * pos
	as shower
		to-from-json shower
	else
		()

-to-from-json[t, u] (t, json) lens(lens (t, u) lens) t data, u data, u from-json, u to-json
	get: of a
		to get lens, a
	set: of a, x
		set lens, a, x.to
