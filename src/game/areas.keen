-backyard-random-item reward-random-item()
	# Omit smoke-bomb (too week), napkin (too powerful)
	# Omit sparkler since it isn't useful outside of the basement
	choices: cookie, hare-plush, ice-soda, lemon, perfume, pepper-bomb, soap, soda, sleep-bomb
-basement-random-item reward-random-item()
	# Also omitting sparkelr here, since those are plentiful as non-random items
	backyard-random-item
-bathroom-random-item reward-random-item()
	# Omit soap since those are plentiful as non-random items
	choices: ice-soda, perfume, smoke-bomb
-bedroom-random-item reward-random-item()
	choices: cookie, hare-plush, sleep-bomb
-foyer-random-item reward-random-item()
	choices: cookie, smoke-bomb
-kitchen-random-item reward-random-item()
	choices: cookie, lemon, pepper-bomb, soda

-garden-slugs slug-config[]()
	- plain-slug slugette
	- plain-slug sluggo
	- plain-slug sluggy
	- plain-slug slugson
	- plain-slug slug-jr
	- plain-slug slugsly
	- plain-slug slug-sr
	- plain-slug slug-x
	- plain-slug slugicus
	- plain-slug sluggus
