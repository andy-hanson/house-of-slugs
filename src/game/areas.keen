		tutorial-slugs: ()
		sprinkle:
			items:
				-- n-of 2, cookie
				-- n-of 2, soda
				-- n-of 2, lemon
				-- n-of 2, pepper-bomb
			slugs:
				- cookie-slug chip
				- cookie-slug cookie
				- cookie-slug oatmeal
				- bomb-slug cayenne, pepper
